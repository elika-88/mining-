# Optional grounded intent routing. `OPENAI_API_KEY` is also supported.
# Leave both values empty to use the fully functional deterministic fallback.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Prototype policy thresholds. Dataset units must be confirmed by the operator.
GAS_WARNING_THRESHOLD=10
GAS_CRITICAL_THRESHOLD=20
TEMPERATURE_WARNING_THRESHOLD=40
TEMPERATURE_CRITICAL_THRESHOLD=50
VISIBILITY_WARNING_THRESHOLD=30
VISIBILITY_CRITICAL_THRESHOLD=10
CO_PRESENCE_WINDOW_MINUTES=5
RISK_CONTEXT_WINDOW_MINUTES=10
ACTIVE_WINDOW_MINUTES=30
